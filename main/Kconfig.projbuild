menu "Presence Detector Configuration"

    menu "WiFi Configuration"
        config WIFI_SSID
            string "WiFi SSID"
            default "your_ssid"
            help
                SSID (network name) to connect to.

        config WIFI_PASSWORD
            string "WiFi Password"
            default "your_password"
            help
                WiFi password (WPA or WPA2).
    endmenu

    menu "MQTT Configuration"
        config MQTT_BROKER_URI
            string "MQTT Broker URI"
            default "mqtt://broker_ip:1883"
            help
                URI of the MQTT broker (e.g., mqtt://192.168.1.100:1883)

        config MQTT_USERNAME
            string "MQTT Username"
            default "mqtt_user"
            help
                Username for MQTT broker authentication.

        config MQTT_PASSWORD
            string "MQTT Password"
            default "mqtt_pass"
            help
                Password for MQTT broker authentication.

        config MQTT_TOPIC_SCAN_REQUEST
            string "MQTT Topic - Scan Request"
            default "home/presence/scan/request"
            help
                Topic to subscribe for scan trigger requests.

        config MQTT_TOPIC_PRESENCE_BASE
            string "MQTT Topic - Presence Base"
            default "home/presence"
            help
                Base topic for presence state publishing.
    endmenu

    menu "Presence Detection Settings"
        config BT_PROBE_TIMEOUT_MS
            int "Probe Timeout (ms)"
            default 8000
            help
                Timeout for SDP probe in milliseconds.

        config BT_INTER_DEVICE_DELAY_MS
            int "Inter-device Delay (ms)"
            default 300
            help
                Delay between probing different devices.

        config BT_MIN_SCAN_INTERVAL_MS
            int "Minimum Scan Interval (ms)"
            default 2000
            help
                Minimum interval between scan cycles.

        config BT_PAIRING_MODE
            bool "Enable Pairing Mode"
            default n
            help
                Enable pairing mode to discover and bond with phones.
                Disable after pairing is complete.
    endmenu

endmenu
